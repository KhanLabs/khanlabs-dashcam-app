<?xml version="1.0" encoding="utf-8"?>
<!-- Dashcam unit mark, v2 (2026-07-18): a solid rounded-square housing (a
     physical device body, not a generic camera-app glyph) with a bold
     cyan lens ring plus pupil and a solid orange rec-light at the
     top-right corner. Redesigned from the original thin-stroke hexagon,
     which read as a near-invisible faint line at real launcher icon
     sizes (5dp stroke at roughly 33% alpha): every shape here is a solid
     fill so the mark stays legible from full-res down to a 48dp
     app-drawer icon.
     The housing intentionally bleeds past the 66dp adaptive-icon safe
     circle (r=33 about center 54,54) at its corners; that is normal for
     a background/body layer, which different launcher masks are
     expected to crop differently. Only the lens and rec-light (the
     parts that must always read) are kept fully inside the safe
     circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Housing: solid rounded-square body, dark graphite against the
         pure-black adaptive-icon background so the device silhouette
         reads as a shape, not just implied by its lens. -->
    <path
        android:fillColor="#212126"
        android:pathData="M38,24 L70,24 A14,14 0 0,1 84,38 L84,70 A14,14 0 0,1 70,84 L38,84 A14,14 0 0,1 24,70 L24,38 A14,14 0 0,1 38,24 Z" />
    <!-- Lens ring, KhanLabs Electric Cyan -->
    <path
        android:fillColor="#00E5FF"
        android:fillType="evenOdd"
        android:pathData="M78,54 a24,24 0 1,0 -48,0 a24,24 0 1,0 48,0 Z M70,54 a16,16 0 1,0 -32,0 a16,16 0 1,0 32,0 Z" />
    <!-- Lens pupil -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M62,54 a8,8 0 1,0 -16,0 a8,8 0 1,0 16,0 Z" />
    <!-- Always-recording indicator, KhanLabs Orange -->
    <path
        android:fillColor="#FF5722"
        android:pathData="M78,36 a6,6 0 1,0 -12,0 a6,6 0 1,0 12,0 Z" />
</vector>
